# Host do banco de dados
DB_HOST=postgres

# Porta do banco de dados
DB_PORT=5432

# Usuário do banco de dados
DB_USER=postgres

# Senha do banco de dados
DB_PASSWORD=postgres

# Nome do banco de dados
DB_NAME=cinelogplay

# Porta em que o servidor da aplicação será executado
# (3001 = padrão do backend, docker-compose e VITE_API_URL do frontend)
PORT=3001

# Ambiente de execução (development, production, etc.)
NODE_ENV=development

# Origem permitida para requisições (CORS)
CORS_ORIGIN=http://localhost:5173
